  "afirmacoes": [
    {
      "id": "01M3SPS2BK340QJ4XRV6MBEJGP",
      "texto": "Laughing Fool, cerca de 1500, é óleo sobre painel, possivelmente de Jacob Cornelisz. van Oostsanen.",
      "tipo": "fato",
      "confianca": "alta",
      "evidencia": "A ficha do Davis Museum no Google Arts & Culture qualifica a atribuição como possível.",
      "fontes": [
        "01M3SPS2BJGA6XJ47BQB6QK6AZ"
      ],
      "regioes": [],
      "apoios": [],
      "proveniencia": {
        "autor": "curadoria",
        "metodo": "curadoria-visual-e-fontes/1"
      }
    },
    {
      "id": "01M3SPS2BK8KJARCE57RKBA1R7",
      "texto": "Uma mão cobre parte do rosto; entre os dedos, um olho permanece visível.",
      "tipo": "observacao",
      "confianca": "alta",
      "evidencia": "Os dedos atravessam o rosto sem ocultar inteiramente os dois olhos.",
      "fontes": [],
      "regioes": [
        "01M3SPS2BKF5YBR618TYZ2WH63"
      ],
      "apoios": [],
      "proveniencia": {
        "autor": "curadoria",
        "metodo": "curadoria-visual-e-fontes/1"
      }
    },
    {
      "id": "01M3SPS2BM78PK1TB17ARX74CD",
      "texto": "A outra mão segura uma armação de óculos abaixo do rosto.",
      "tipo": "observacao",
      "confianca": "alta",
      "evidencia": "Os dois aros estão junto à roupa, afastados dos olhos.",
      "fontes": [],
      "regioes": [
        "01M3SPS2BKPTR4AEY52QYQA1PY"
      ],
      "apoios": [],
      "proveniencia": {
        "autor": "curadoria",
        "metodo": "curadoria-visual-e-fontes/1"
      }
    },
    {
      "id": "01M3SPS2BME5M0E3G6EJ1EQSJR",
      "texto": "Há uma pequena cabeça na extremidade do bastão, no alto à direita.",
      "tipo": "observacao",
      "confianca": "alta",
      "evidencia": "O rosto esculpido ocupa o canto superior direito.",
      "fontes": [],
      "regioes": [
        "01M3SPS2BKRX2XFRJPA1W89G91"
      ],
      "apoios": [],
      "proveniencia": {
        "autor": "curadoria",
        "metodo": "curadoria-visual-e-fontes/1"
      }
    },
    {
      "id": "01M3SPS2BM2KD75WX3NV7696Z5",
      "texto": "O Fastnachtsmuseum interpreta os óculos como atributo da simplicidade do tolo.",
      "tipo": "interpretacao_documentada",
      "confianca": "alta",
      "evidencia": "O texto curatorial associa os óculos à simplicidade e descreve traje, capuz e cetro.",
      "fontes": [
        "01M3SPS2BJ89YP33BPB7VTCFR9"
      ],
      "regioes": [
        "01M3SPS2BKPTR4AEY52QYQA1PY"
      ],
      "apoios": [],
      "proveniencia": {
        "autor": "curadoria",
        "metodo": "curadoria-visual-e-fontes/1"
      }
    },
    {
      "id": "01M3SPS2BMDASJYBA88600DCVA",
      "texto": "A pintura permite relacionar o gesto de esconder os olhos com os óculos que não estão sendo usados.",
      "tipo": "inferencia_ia",
      "confianca": "media",
      "evidencia": "Associação visual proposta entre dois detalhes, sem afirmar uma mensagem secreta do artista.",
