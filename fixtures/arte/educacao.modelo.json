    {
      "id": "01M3SPS2BJ2SC0GY09FCN1YBNF",
      "texto": "A lei de 1880 exigiu regras locais de frequência escolar em todos os distritos da Inglaterra e do País de Gales.",
      "tipo": "fato",
      "confianca": "alta",
      "evidencia": "Resposta de Mundella de 8/7/1881 explicita distritos, território e prazo de implementação.",
