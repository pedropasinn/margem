    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "playwright": "1.63.0",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
