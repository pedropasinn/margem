{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://margem.local/contratos/JobResultV1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "job_id",
    "attempt",
    "lease_token",
    "estado",
    "diagnosticos",
    "duracao_ms"
  ],
  "properties": {
    "job_id": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "lease_token": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "estado": {
      "type": "string",
      "enum": [
        "ok",
        "falhou",
        "adiado"
      ]
    },
    "artefato": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caminho",
        "sha256"
      ],
      "properties": {
        "caminho": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "diagnosticos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nivel",
          "codigo",
          "mensagem"
        ],
        "properties": {
          "nivel": {
            "type": "string",
            "enum": [
              "info",
              "aviso",
              "erro"
            ]
          },
          "codigo": {
            "type": "string",
            "minLength": 1
          },
          "mensagem": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 0
    },
    "modelo": {
      "type": "string",
      "minLength": 1
    },
    "duracao_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "not_before": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "estado": {
            "const": "ok"
          }
        },
        "required": [
          "estado"
        ]
      },
      "then": {
        "required": [
          "artefato"
        ],
        "properties": {
          "artefato": {}
        }
      },
      "else": {
        "not": {
          "required": [
            "artefato"
          ],
          "properties": {
            "artefato": {}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "estado": {
            "const": "adiado"
          }
        },
        "required": [
          "estado"
        ]
      },
      "then": {
        "required": [
          "not_before"
        ],
        "properties": {
          "not_before": {}
        }
      },
      "else": {
        "not": {
          "required": [
            "not_before"
          ],
          "properties": {
            "not_before": {}
          }
        }
      }
    }
  ]
}
