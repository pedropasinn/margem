{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://margem.local/contratos/SalaDeTesteV1.schema.json",
  "title": "Sala de teste: documentos da biblioteca abertos a testadores por senha, com formulário de feedback",
  "type": "object",
  "additionalProperties": false,
  "required": ["versao", "id", "slug", "titulo", "boas_vindas", "documentos", "ativa", "expira_em", "formulario", "criada_em", "atualizada_em"],
  "properties": {
    "versao": { "const": 1 },
    "id": { "$ref": "#/$defs/ulid" },
    "slug": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{4,62})[a-z0-9]$" },
    "titulo": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^(?=[^\\r\\n]*\\S)[^\\r\\n\\u2028\\u2029]+$"
    },
    "boas_vindas": { "type": "string", "maxLength": 4000 },
    "documentos": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/ulid" } },
    "ativa": { "type": "boolean" },
    "expira_em": { "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] },
    "formulario": { "$ref": "https://margem.local/contratos/FormularioDaSalaV1.schema.json" },
    "criada_em": { "type": "string", "format": "date-time" },
    "atualizada_em": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "ulid": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" }
  }
}
