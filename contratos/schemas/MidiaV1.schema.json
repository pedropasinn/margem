{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://margem.local/contratos/MidiaV1.schema.json",
  "description": "Mídia (vídeo ou áudio) de um documento cuja versão de texto é a transcrição. O alinhamento palavra→tempo pertence à versão: offsets UTF-16 no texto do bloco, resolvidos pelo serviço.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "versao",
    "id",
    "documento_id",
    "versao_id",
    "tipo",
    "titulo",
    "sha256",
    "mime",
    "bytes",
    "duracao_s",
    "fonte",
    "transcricao",
    "capitulos",
    "palavras",
    "frases"
  ],
  "properties": {
    "versao": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "documento_id": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "versao_id": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "tipo": {
      "enum": [
        "video",
        "audio"
      ]
    },
    "titulo": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "mime": {
      "enum": [
        "video/mp4",
        "video/webm",
        "audio/mpeg",
        "audio/mp4",
        "audio/webm",
        "audio/ogg"
      ]
    },
    "bytes": {
      "type": "integer",
      "minimum": 1
    },
    "duracao_s": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "largura": {
      "type": "integer",
      "minimum": 1
    },
    "altura": {
      "type": "integer",
      "minimum": 1
    },
    "fonte": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url"
          ],
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https://",
              "maxLength": 2000
            },
            "canal": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "publicado_em": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        }
      ]
    },
    "transcricao": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "motor",
        "idioma",
        "sha256"
      ],
      "properties": {
        "motor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "idioma": {
          "type": "string",
          "minLength": 2,
          "maxLength": 35
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "capitulos": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "inicio_s",
          "titulo"
        ],
        "properties": {
          "inicio_s": {
            "type": "number",
            "minimum": 0
          },
          "titulo": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    },
    "palavras": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bloco_id",
          "inicio_utf16",
          "fim_utf16",
          "inicio_s",
          "fim_s"
        ],
        "properties": {
          "bloco_id": {
            "type": "string",
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
          },
          "inicio_utf16": {
            "type": "integer",
            "minimum": 0
          },
          "fim_utf16": {
            "type": "integer",
            "minimum": 1
          },
          "inicio_s": {
            "type": "number",
            "minimum": 0
          },
          "fim_s": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "frases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bloco_id",
          "inicio_utf16",
          "fim_utf16",
          "inicio_s",
          "fim_s"
        ],
        "properties": {
          "bloco_id": {
            "type": "string",
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
          },
          "inicio_utf16": {
            "type": "integer",
            "minimum": 0
          },
          "fim_utf16": {
            "type": "integer",
            "minimum": 1
          },
          "inicio_s": {
            "type": "number",
            "minimum": 0
          },
          "fim_s": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    }
  }
}