{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://margem.local/contratos/NarracaoDaVisitaV1.schema.json",
  "title": "Narração da visita guiada de um capítulo (J91)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "versao",
    "id",
    "roteiro_id",
    "sha256_audio",
    "voz_sha256",
    "job_colab",
    "receita",
    "duracao_s",
    "falas",
    "criado_em"
  ],
  "properties": {
    "versao": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "roteiro_id": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "sha256_audio": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "voz_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "job_colab": {
      "type": "string",
      "pattern": "^job_[a-f0-9]+$"
    },
    "receita": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "duracao_s": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "falas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fala_id",
          "inicio_s",
          "fim_s"
        ],
        "properties": {
          "fala_id": {
            "type": "string",
            "pattern": "^f[0-9]{3}$"
          },
          "inicio_s": {
            "type": "number",
            "minimum": 0
          },
          "fim_s": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "criado_em": {
      "type": "string",
      "format": "date-time"
    }
  }
}