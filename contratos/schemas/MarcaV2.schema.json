{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://margem.local/contratos/MarcaV2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "ancora",
    "funcao",
    "saliencia",
    "subfaixas",
    "comentario",
    "origem",
    "validade",
    "visivel",
    "avaliacao",
    "camada_id",
    "modo",
    "criada_em"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "ancora": {
      "$ref": "https://margem.local/contratos/AncoraV1.schema.json"
    },
    "funcao": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
      "maxLength": 40
    },
    "saliencia": {
      "type": "integer",
      "enum": [
        1,
        2,
        3
      ]
    },
    "subfaixas": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "inicio_utf16",
          "fim_utf16"
        ],
        "properties": {
          "inicio_utf16": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "fim_utf16": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        }
      }
    },
    "comentario": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tipo",
            "rotulo",
            "texto"
          ],
          "properties": {
            "tipo": {
              "type": "string",
              "enum": [
                "AUTOR",
                "LEITURA",
                "INVESTIGAR",
                "OBJECAO",
                "CONEXAO",
                "TENSAO",
                "PREREQUISITO"
              ]
            },
            "rotulo": {
              "type": "string",
              "minLength": 1
            },
            "texto": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "origem": {
      "type": "string",
      "enum": [
        "parte",
        "revisao_consistencia",
        "revisao_cobertura",
        "manual",
        "importacao",
        "projecao"
      ]
    },
    "validade": {
      "type": "string",
      "enum": [
        "resolvida",
        "ambigua",
        "orfa"
      ]
    },
    "visivel": {
      "type": "boolean"
    },
    "avaliacao": {
      "type": "string",
      "enum": [
        "nao_avaliada",
        "confirmada",
        "rejeitada"
      ]
    },
    "camada_id": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "modo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revisao"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
          "maxLength": 40
        },
        "revisao": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "execucao_id": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "job_id": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "criada_em": {
      "type": "string",
      "format": "date-time"
    }
  }
}
