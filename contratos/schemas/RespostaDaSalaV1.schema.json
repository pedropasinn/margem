{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://margem.local/contratos/RespostaDaSalaV1.schema.json",
  "title": "Respostas de um testador ao formulário de uma sala de teste: rascunho ou enviada",
  "type": "object",
  "additionalProperties": false,
  "required": ["versao", "estado", "geral", "por_documento", "atualizada_em", "enviada_em"],
  "properties": {
    "versao": { "const": 1 },
    "estado": { "enum": ["rascunho", "enviada"] },
    "geral": { "$ref": "#/$defs/respostas" },
    "por_documento": {
      "type": "object",
      "maxProperties": 20,
      "propertyNames": { "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" },
      "additionalProperties": { "$ref": "#/$defs/respostas" }
    },
    "atualizada_em": { "type": "string", "format": "date-time" },
    "enviada_em": { "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] }
  },
  "$defs": {
    "respostas": {
      "type": "object",
      "maxProperties": 30,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,39}$" },
      "additionalProperties": {
        "anyOf": [
          { "type": "integer", "minimum": 1, "maximum": 5 },
          { "type": "string", "maxLength": 5000 }
        ]
      }
    }
  }
}
