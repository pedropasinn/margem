{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://margem.local/contratos/AncoraV1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "versao_id",
    "bloco_id",
    "inicio_utf16",
    "fim_utf16",
    "citacao",
    "prefixo",
    "sufixo"
  ],
  "properties": {
    "versao_id": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "bloco_id": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "inicio_utf16": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "fim_utf16": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "citacao": {
      "type": "string",
      "minLength": 1
    },
    "prefixo": {
      "type": "string"
    },
    "sufixo": {
      "type": "string"
    }
  }
}
