{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://margem.local/contratos/ModeloDaObraV1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "versao",
    "id",
    "revisao",
    "identidade",
    "imagem",
    "localizacao",
    "fontes",
    "regioes",
    "afirmacoes",
    "estudo",
    "limites"
  ],
  "properties": {
    "versao": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "revisao": {
      "type": "integer",
      "minimum": 1
    },
    "identidade": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "titulo",
        "titulo_original",
        "artista",
        "data",
        "tecnica",
        "afirmacoes"
      ],
      "properties": {
        "titulo": {
          "type": "string",
          "minLength": 1
        },
        "titulo_original": {
          "type": "string",
          "minLength": 1
        },
        "artista": {
          "type": "string",
          "minLength": 1
        },
        "data": {
          "type": "string",
          "minLength": 1
        },
        "tecnica": {
          "type": "string",
          "minLength": 1
        },
        "afirmacoes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      }
    },
    "imagem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "sha256",
        "largura",
        "altura",
        "credito",
        "fonte_id"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^/arte/[a-z0-9-]+\\.jpg$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "largura": {
          "type": "integer",
          "minimum": 1
        },
        "altura": {
          "type": "integer",
          "minimum": 1
        },
        "credito": {
          "type": "string",
          "minLength": 1
        },
        "fonte_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "localizacao": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instituicao_proprietaria",
        "localizacao_conhecida",
        "atualmente_exposto",
        "sala",
        "verificado_em",
        "fontes"
      ],
      "properties": {
        "instituicao_proprietaria": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "localizacao_conhecida": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "atualmente_exposto": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "sala": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "verificado_em": {
          "type": "string",
          "format": "date"
        },
        "fontes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      }
    },
    "fontes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "titulo",
          "url",
          "categoria",
          "consultado_em"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "titulo": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "categoria": {
            "type": "string",
            "enum": [
              "instituicao_proprietaria",
              "museu",
              "catalogo",
              "academica",
              "arquivo",
              "leilao",
              "google_arts",
              "secundaria",
              "popular"
            ]
          },
          "consultado_em": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "minItems": 1
    },
    "regioes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "rotulo",
          "imagem_sha256",
          "forma"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "rotulo": {
            "type": "string",
            "minLength": 1
          },
          "imagem_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "forma": {
            "$ref": "#/$defs/forma"
          }
        }
      },
      "minItems": 1
    },
    "afirmacoes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "texto",
          "tipo",
          "confianca",
          "evidencia",
          "fontes",
          "regioes",
          "apoios",
          "proveniencia"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "texto": {
            "type": "string",
            "minLength": 1
          },
          "tipo": {
            "type": "string",
            "enum": [
              "observacao",
              "fato",
              "interpretacao_documentada",
              "inferencia_ia",
              "intencao_desconhecida"
            ]
          },
          "confianca": {
            "type": "string",
            "enum": [
              "alta",
              "media",
              "baixa",
              "nao_aplicavel"
            ]
          },
          "evidencia": {
            "type": "string",
            "minLength": 1
          },
          "fontes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "regioes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "apoios": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "proveniencia": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "autor",
              "metodo"
            ],
            "properties": {
              "autor": {
                "type": "string",
                "enum": [
                  "curadoria",
                  "ia"
                ]
              },
              "metodo": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "minItems": 1
    },
    "estudo": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tema",
          "afirmacoes"
        ],
        "properties": {
          "tema": {
            "type": "string",
            "enum": [
              "composicao",
              "iconografia",
              "tecnica",
              "historia",
              "artista",
              "contexto",
              "interpretacoes",
              "obras_relacionadas"
            ]
          },
          "afirmacoes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        }
      },
      "minItems": 0
    },
    "limites": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    }
  },
  "$defs": {
    "forma": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tipo",
            "x",
            "y",
            "largura",
            "altura"
          ],
          "properties": {
            "tipo": {
              "const": "bbox"
            },
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "largura": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "altura": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tipo",
            "x",
            "y"
          ],
          "properties": {
            "tipo": {
              "const": "ponto"
            },
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tipo",
            "pontos"
          ],
          "properties": {
            "tipo": {
              "const": "poligono"
            },
            "pontos": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "x",
                  "y"
                ],
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              },
              "minItems": 3
            }
          }
        }
      ]
    }
  }
}
