{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://margem.local/contratos/NarracaoDaLeituraV1.schema.json",
  "title": "Narração da leitura comentada de um capítulo (J92)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "versao",
    "id",
    "leitura_id",
    "sha256_audio",
    "voz_sha256",
    "jobs_colab",
    "receita",
    "duracao_s",
    "transicao",
    "falas",
    "palavras",
    "criado_em"
  ],
  "properties": {
    "versao": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "leitura_id": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "sha256_audio": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "voz_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "jobs_colab": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^job_[a-f0-9]+$"
      }
    },
    "receita": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "duracao_s": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "transicao": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "silencio_antes_s",
        "silencio_depois_s",
        "sinal",
        "contraste"
      ],
      "properties": {
        "silencio_antes_s": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "silencio_depois_s": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "sinal": {
          "type": "boolean"
        },
        "contraste": {
          "type": "boolean"
        }
      }
    },
    "falas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fala_id",
          "inicio_s",
          "fim_s"
        ],
        "properties": {
          "fala_id": {
            "type": "string",
            "pattern": "^[tp][0-9]{3,5}$"
          },
          "inicio_s": {
            "type": "number",
            "minimum": 0
          },
          "fim_s": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "palavras": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bloco_id",
          "inicio_utf16",
          "fim_utf16",
          "inicio_s",
          "fim_s"
        ],
        "properties": {
          "bloco_id": {
            "type": "string",
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
          },
          "inicio_utf16": {
            "type": "integer",
            "minimum": 0
          },
          "fim_utf16": {
            "type": "integer",
            "minimum": 1
          },
          "inicio_s": {
            "type": "number",
            "minimum": 0
          },
          "fim_s": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "criado_em": {
      "type": "string",
      "format": "date-time"
    }
  }
}
