{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://margem.local/contratos/ModoDeLeituraV1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "versao",
    "id",
    "revisao",
    "nome",
    "descricao",
    "funcoes",
    "comentarios",
    "saliencia"
  ],
  "properties": {
    "versao": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
      "maxLength": 40
    },
    "revisao": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "nome": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "descricao": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "funcoes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "chave",
          "rotulo",
          "pergunta",
          "descricao",
          "cor"
        ],
        "properties": {
          "chave": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
            "maxLength": 40,
            "not": {
              "const": "nenhuma"
            }
          },
          "rotulo": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "pergunta": {
            "type": "string",
            "minLength": 2,
            "maxLength": 200,
            "pattern": "\\?$"
          },
          "descricao": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "cor": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "claro",
              "escuro"
            ],
            "properties": {
              "claro": {
                "type": "string",
                "pattern": "^#[0-9A-F]{6}$"
              },
              "escuro": {
                "type": "string",
                "pattern": "^#[0-9A-F]{6}$"
              }
            }
          }
        }
      }
    },
    "comentarios": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "AUTOR",
          "LEITURA",
          "INVESTIGAR",
          "OBJECAO",
          "CONEXAO",
          "TENSAO",
          "PREREQUISITO"
        ]
      }
    },
    "saliencia": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alvo_por_nivel"
      ],
      "properties": {
        "alvo_por_nivel": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "1",
            "2",
            "3"
          ],
          "properties": {
            "1": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 0.5
            },
            "2": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 0.5
            },
            "3": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 0.5
            }
          }
        }
      }
    }
  }
}
