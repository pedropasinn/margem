{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://margem.local/contratos/AudioV1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "versao",
    "id",
    "versao_id",
    "secao_id",
    "titulo",
    "sha256_audio",
    "voz_sha256",
    "job_colab",
    "duracao_s",
    "trechos"
  ],
  "properties": {
    "versao": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "versao_id": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "secao_id": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "titulo": {
      "type": "string",
      "minLength": 1
    },
    "sha256_audio": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "voz_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "job_colab": {
      "type": "string",
      "pattern": "^job_[a-f0-9]+$"
    },
    "duracao_s": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "trechos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "inicio_s",
          "fim_s",
          "ancora"
        ],
        "properties": {
          "inicio_s": {
            "type": "number",
            "minimum": 0
          },
          "fim_s": {
            "type": "number",
            "minimum": 0
          },
          "ancora": {
            "$ref": "https://margem.local/contratos/AncoraV1.schema.json"
          }
        }
      }
    }
  }
}
