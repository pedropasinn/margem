{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://margem.local/contratos/RoteiroGuiadoV1.schema.json",
  "title": "Roteiro narrado da visita guiada de um capítulo (J91)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "versao",
    "id",
    "execucao_id",
    "versao_id",
    "secao_id",
    "modelo_id",
    "perfil_hash",
    "capitulo",
    "paradas",
    "falas",
    "perguntas_finais",
    "proxima_secao_id",
    "diagnosticos",
    "execucao",
    "job_id",
    "criado_em"
  ],
  "properties": {
    "versao": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "execucao_id": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "versao_id": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "secao_id": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "modelo_id": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "perfil_hash": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "capitulo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "titulo",
        "numero",
        "total"
      ],
      "properties": {
        "titulo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "numero": {
          "type": "integer",
          "minimum": 1
        },
        "total": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "paradas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ordem",
          "tipo",
          "titulo",
          "bloco_inicio",
          "bloco_fim",
          "foco",
          "ponta",
          "elementos",
          "relacoes",
          "dificuldades",
          "anotacoes",
          "visuais",
          "pergunta"
        ],
        "properties": {
          "ordem": {
            "type": "integer",
            "minimum": 1
          },
          "tipo": {
            "enum": [
              "tese",
              "conceito",
              "argumento",
              "exemplo",
              "relacao",
              "retorno",
              "dificuldade",
              "visual",
              "nota",
              "pergunta"
            ]
          },
          "titulo": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "bloco_inicio": {
            "type": "string",
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
          },
          "bloco_fim": {
            "type": "string",
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
          },
          "foco": {
            "$ref": "https://margem.local/contratos/AncoraV1.schema.json"
          },
          "ponta": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "$ref": "https://margem.local/contratos/AncoraV1.schema.json"
              }
            ]
          },
          "elementos": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
            },
            "uniqueItems": true
          },
          "relacoes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
            },
            "uniqueItems": true
          },
          "dificuldades": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
            },
            "uniqueItems": true
          },
          "anotacoes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
            },
            "uniqueItems": true
          },
          "visuais": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
            },
            "uniqueItems": true
          },
          "pergunta": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              }
            ]
          }
        }
      }
    },
    "falas": {
      "type": "array",
      "minItems": 2,
      "maxItems": 80,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "papel",
          "parada",
          "texto"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^f[0-9]{3}$"
          },
          "papel": {
            "enum": [
              "abertura",
              "parada",
              "pergunta",
              "transicao",
              "fechamento",
              "ponte"
            ]
          },
          "parada": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "integer",
                "minimum": 1
              }
            ]
          },
          "texto": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1600
          }
        }
      }
    },
    "perguntas_finais": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 600
      }
    },
    "proxima_secao_id": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        }
      ]
    },
    "diagnosticos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "codigo",
          "mensagem"
        ],
        "properties": {
          "codigo": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "mensagem": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          }
        }
      }
    },
    "execucao": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelo",
        "esforco",
        "prompt"
      ],
      "properties": {
        "modelo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "esforco": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "job_id": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "criado_em": {
      "type": "string",
      "format": "date-time"
    }
  }
}