{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "titulo": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "abertura": {
      "type": "string",
      "minLength": 1,
      "maxLength": 900
    },
    "roteiro": {
      "type": "string",
      "maxLength": 6500
    },
    "noticias": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "titulo": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          },
          "resumo": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1600
          },
          "importancia": {
            "type": "string",
            "minLength": 1,
            "maxLength": 700
          },
          "projeto": {
            "enum": [
              "Margem",
              "Gibraltar",
              "Series",
              "Geral"
            ],
            "type": "string"
          },
          "natureza": {
            "enum": [
              "novidade",
              "atualizacao",
              "repertorio"
            ],
            "type": "string"
          },
          "evidencias": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "fonte_url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://",
                  "maxLength": 2048
                },
                "citacao": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1500
                }
              },
              "required": [
                "fonte_url",
                "citacao"
              ]
            }
          },
          "limite": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "titulo",
          "resumo",
          "importancia",
          "projeto",
          "natureza",
          "evidencias",
          "limite"
        ]
      }
    },
    "versao": {
      "const": 1
    },
    "corte_em": {
      "type": "string",
      "format": "date-time"
    },
    "foco": {
      "const": "ia_aplicada"
    },
    "fontes": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "maxLength": 2048
          },
          "titulo": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "publicada_em": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "texto": {
            "type": "string",
            "minLength": 1,
            "maxLength": 18000
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "acesso": {
            "enum": [
              "pagina",
              "feed"
            ],
            "type": "string"
          }
        },
        "required": [
          "url",
          "titulo",
          "publicada_em",
          "texto",
          "sha256",
          "acesso"
        ]
      }
    },
    "cobertura": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "nome": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "maxLength": 2048
          },
          "estado": {
            "enum": [
              "ok",
              "parcial",
              "falhou"
            ],
            "type": "string"
          },
          "candidatos": {
            "type": "integer",
            "minimum": 0
          },
          "lidos": {
            "type": "integer",
            "minimum": 0
          },
          "limite": {
            "type": "string",
            "maxLength": 700
          }
        },
        "required": [
          "nome",
          "url",
          "estado",
          "candidatos",
          "lidos",
          "limite"
        ]
      }
    }
  },
  "required": [
    "titulo",
    "abertura",
    "roteiro",
    "noticias",
    "versao",
    "corte_em",
    "foco",
    "fontes",
    "cobertura"
  ]
}
