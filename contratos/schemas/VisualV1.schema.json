{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://margem.local/contratos/VisualV1.schema.json",
  "title": "Visual ancorado (J70): imagem ou fluxograma gerado pelo Codex a pedido do leitor, ligado a um trecho, a um bloco ou ao capítulo",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "versao",
    "id",
    "versao_id",
    "secao_id",
    "tipo",
    "alvo",
    "estado",
    "diagnosticos",
    "criado_em",
    "atualizado_em"
  ],
  "properties": {
    "versao": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "versao_id": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "secao_id": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "imagem",
        "diagrama"
      ]
    },
    "alvo": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tipo",
            "ancora"
          ],
          "properties": {
            "tipo": {
              "const": "trecho"
            },
            "ancora": {
              "$ref": "https://margem.local/contratos/AncoraV1.schema.json"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tipo",
            "ancora"
          ],
          "properties": {
            "tipo": {
              "const": "bloco"
            },
            "ancora": {
              "$ref": "https://margem.local/contratos/AncoraV1.schema.json"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tipo"
          ],
          "properties": {
            "tipo": {
              "const": "capitulo"
            }
          }
        }
      ]
    },
    "pedido": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S"
    },
    "estado": {
      "type": "string",
      "enum": [
        "pendente",
        "executando",
        "pronto",
        "falhou"
      ]
    },
    "motivo": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "artefato": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tipo",
            "sha256",
            "bytes",
            "largura",
            "altura",
            "descricao"
          ],
          "properties": {
            "tipo": {
              "const": "png"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            },
            "largura": {
              "type": "integer",
              "minimum": 1
            },
            "altura": {
              "type": "integer",
              "minimum": 1
            },
            "descricao": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tipo",
            "codigo",
            "titulo",
            "nos"
          ],
          "properties": {
            "tipo": {
              "const": "mermaid"
            },
            "codigo": {
              "type": "string",
              "minLength": 12,
              "maxLength": 20000
            },
            "titulo": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "nos": {
              "type": "array",
              "minItems": 1,
              "maxItems": 80,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "rotulo"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$"
                  },
                  "rotulo": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "ancora": {
                    "$ref": "https://margem.local/contratos/AncoraV1.schema.json"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "diagnosticos": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "codigo",
          "mensagem"
        ],
        "properties": {
          "codigo": {
            "type": "string",
            "minLength": 1
          },
          "mensagem": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "substitui": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "execucao": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelo",
        "esforco"
      ],
      "properties": {
        "modelo": {
          "type": "string",
          "minLength": 1
        },
        "esforco": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "criado_em": {
      "type": "string",
      "format": "date-time"
    },
    "atualizado_em": {
      "type": "string",
      "format": "date-time"
    }
  }
}
