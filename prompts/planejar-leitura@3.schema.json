{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://margem.local/prompts/planejar-leitura@3.schema.json",
  "title": "Saída do planejamento da leitura guiada",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "passos",
    "apoios"
  ],
  "properties": {
    "passos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "inicio",
          "foco",
          "observar",
          "explicacao",
          "relacoes",
          "parada"
        ],
        "properties": {
          "inicio": {
            "type": "string",
            "pattern": "^B[0-9]{3,}$"
          },
          "foco": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^L[0-9]{2,}$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "observar": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "explicacao": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "curta",
              "longa"
            ],
            "properties": {
              "curta": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1200
              },
              "longa": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            }
          },
          "relacoes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^R[0-9]{2,}$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "parada": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "tipo",
                  "texto"
                ],
                "properties": {
                  "tipo": {
                    "type": "string",
                    "enum": [
                      "pergunta",
                      "pausa"
                    ]
                  },
                  "texto": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  }
                }
              }
            ]
          }
        }
      },
      "minItems": 1
    },
    "apoios": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "alvo",
          "tipo",
          "texto"
        ],
        "properties": {
          "alvo": {
            "type": "string",
            "pattern": "^(L[0-9]{2,}|D[0-9]{2,})$"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "explicar",
              "omitir",
              "exemplo",
              "recordar"
            ]
          },
          "texto": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      },
      "minItems": 0
    }
  }
}
