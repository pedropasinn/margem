{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://margem.local/prompts/analisar-passagens@1.schema.json",
  "title": "Saída da análise local de uma parte",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "elementos",
    "relacoes",
    "dificuldades",
    "resumo_da_parte",
    "limites",
    "leitura_integral"
  ],
  "properties": {
    "elementos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "nucleo",
          "papel",
          "citacoes",
          "enunciado",
          "qualificadores",
          "centralidade",
          "notas"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^n[0-9]+$"
          },
          "nucleo": {
            "type": "string",
            "enum": [
              "afirmacao",
              "conceito",
              "hipotese",
              "evidencia",
              "exemplo",
              "objecao",
              "passo",
              "elemento_textual"
            ]
          },
          "papel": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
                "maxLength": 40
              }
            ]
          },
          "citacoes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "bloco",
                "citacao",
                "prefixo",
                "sufixo"
              ],
              "properties": {
                "bloco": {
                  "type": "string",
                  "pattern": "^B[0-9]{3,}$"
                },
                "citacao": {
                  "type": "string",
                  "minLength": 1
                },
                "prefixo": {
                  "type": "string"
                },
                "sufixo": {
                  "type": "string"
                }
              }
            },
            "minItems": 1,
            "maxItems": 3
          },
          "enunciado": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "qualificadores": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "centralidade": {
            "type": "integer",
            "enum": [
              1,
              2,
              3
            ]
          },
          "notas": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "tipo",
                "texto"
              ],
              "properties": {
                "tipo": {
                  "type": "string",
                  "enum": [
                    "LEITURA",
                    "INVESTIGAR",
                    "OBJECAO",
                    "TENSAO"
                  ]
                },
                "texto": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              }
            },
            "minItems": 0
          }
        }
      },
      "minItems": 0
    },
    "relacoes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "origem",
          "destino",
          "tipo",
          "explicacao",
          "confianca"
        ],
        "properties": {
          "origem": {
            "type": "string",
            "pattern": "^n[0-9]+$"
          },
          "destino": {
            "type": "string",
            "pattern": "^n[0-9]+$"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "suporta",
              "desenvolve",
              "pressupoe",
              "contrasta",
              "exemplifica",
              "retoma",
              "responde",
              "tensiona",
              "ecoa"
            ]
          },
          "explicacao": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "confianca": {
            "type": "string",
            "enum": [
              "alta",
              "media",
              "baixa"
            ]
          }
        }
      },
      "minItems": 0
    },
    "dificuldades": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tipo",
          "citacoes",
          "descricao"
        ],
        "properties": {
          "tipo": {
            "type": "string",
            "enum": [
              "premissa_implicita",
              "mudanca_de_notacao",
              "sintaxe_complexa",
              "conceito_sem_definicao",
              "salto_argumentativo",
              "referencia_externa",
              "ambiguidade"
            ]
          },
          "citacoes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "bloco",
                "citacao",
                "prefixo",
                "sufixo"
              ],
              "properties": {
                "bloco": {
                  "type": "string",
                  "pattern": "^B[0-9]{3,}$"
                },
                "citacao": {
                  "type": "string",
                  "minLength": 1
                },
                "prefixo": {
                  "type": "string"
                },
                "sufixo": {
                  "type": "string"
                }
              }
            },
            "minItems": 1,
            "maxItems": 3
          },
          "descricao": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      },
      "minItems": 0
    },
    "resumo_da_parte": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "limites": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "minItems": 0
    },
    "leitura_integral": {
      "type": "boolean"
    }
  }
}
