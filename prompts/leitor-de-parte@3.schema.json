{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://margem.local/prompts/leitor-de-parte@3.schema.json",
  "title": "Saída do leitor de parte, versão 2",
  "type": "object",
  "additionalProperties": false,
  "required": ["marcas", "resumo_da_parte", "limites", "leitura_integral"],
  "properties": {
    "marcas": {
      "type": "array",
      "minItems": 0,
      "description": "MarcaGeradaV2: sem id, sem offsets, sem página. O serviço especializa funcao, saliencia e comentario.tipo pelo modo e pelo nível.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bloco_id", "citacao", "prefixo", "sufixo", "funcao", "saliencia", "sublinhar", "comentario"],
        "properties": {
          "bloco_id": {
            "type": "string",
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
            "description": "Identificador recebido na entrada; o modelo apenas o ecoa."
          },
          "citacao": { "type": "string", "minLength": 1 },
          "prefixo": { "type": "string" },
          "sufixo": { "type": "string" },
          "funcao": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$", "maxLength": 40 },
          "saliencia": { "type": "integer", "enum": [1, 2, 3] },
          "sublinhar": {
            "type": "array",
            "minItems": 0,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "comentario": {
            "anyOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["tipo", "rotulo", "texto"],
                "properties": {
                  "tipo": { "type": "string", "enum": ["AUTOR", "LEITURA", "INVESTIGAR", "OBJECAO", "CONEXAO", "TENSAO", "PREREQUISITO"] },
                  "rotulo": { "type": "string", "minLength": 1 },
                  "texto": { "type": "string", "minLength": 1 }
                }
              }
            ]
          }
        }
      }
    },
    "resumo_da_parte": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "description": "O que a parte seguinte do mesmo capítulo precisa saber."
    },
    "limites": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "leitura_integral": { "type": "boolean" }
  }
}
