{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://margem.local/prompts/arte-modelo@2.schema.json",
  "title": "Modelo da obra, algoritmo v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "regioes",
    "afirmacoes",
    "teses",
    "limites"
  ],
  "properties": {
    "regioes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rotulo",
          "objeto",
          "forma"
        ],
        "properties": {
          "rotulo": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "objeto": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "forma": {
            "$ref": "#/$defs/forma"
          }
        }
      }
    },
    "afirmacoes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 18,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "texto",
          "tipo",
          "dimensao",
          "confianca",
          "evidencia",
          "fontes",
          "citacoes",
          "regioes",
          "apoios"
        ],
        "properties": {
          "texto": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "tipo": {
            "type": "string",
            "enum": [
              "observacao",
              "fato",
              "interpretacao_documentada",
              "inferencia_ia",
              "intencao_desconhecida"
            ]
          },
          "dimensao": {
            "type": "string",
            "enum": [
              "composicao",
              "iconografia",
              "tecnica",
              "historia",
              "artista",
              "contexto",
              "interpretacoes",
              "obras_relacionadas"
            ]
          },
          "confianca": {
            "type": "string",
            "enum": [
              "alta",
              "media",
              "baixa",
              "nao_aplicavel"
            ]
          },
          "evidencia": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "fontes": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "citacoes": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "fonte",
                "trecho"
              ],
              "properties": {
                "fonte": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "trecho": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 600
                }
              }
            }
          },
          "regioes": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "apoios": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "teses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "texto",
          "afirmacoes",
          "gancho",
          "por_que_interessa"
        ],
        "properties": {
          "texto": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "afirmacoes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "gancho": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "por_que_interessa": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        }
      }
    },
    "limites": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 400
      }
    }
  },
  "$defs": {
    "forma": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tipo",
            "x",
            "y",
            "largura",
            "altura"
          ],
          "properties": {
            "tipo": {
              "const": "bbox"
            },
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "largura": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "altura": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tipo",
            "x",
            "y"
          ],
          "properties": {
            "tipo": {
              "const": "ponto"
            },
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tipo",
            "pontos"
          ],
          "properties": {
            "tipo": {
              "const": "poligono"
            },
            "pontos": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "x",
                  "y"
                ],
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              },
              "minItems": 3
            }
          }
        }
      ]
    }
  }
}