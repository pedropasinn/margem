{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://margem.local/prompts/agente-mapa@1.schema.json",
  "title": "Mapa corrigido do agente da biblioteca, versão 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["mermaid", "nos"],
  "properties": {
    "mermaid": { "type": "string", "minLength": 12, "maxLength": 20000 },
    "nos": {
      "type": "array",
      "minItems": 1,
      "maxItems": 80,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "rotulo", "ref"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$" },
          "rotulo": { "type": "string", "minLength": 1, "maxLength": 200 },
          "ref": { "anyOf": [{ "type": "string", "pattern": "^c[0-9]{1,3}$" }, { "type": "null" }] }
        }
      }
    }
  }
}
