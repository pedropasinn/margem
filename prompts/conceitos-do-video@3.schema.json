{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://margem.local/prompts/conceitos-do-video@3.schema.json",
  "title": "Análise do vídeo: partes e momentos, versão 3",
  "type": "object",
  "additionalProperties": false,
  "required": ["partes", "momentos"],
  "properties": {
    "partes": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["paragrafo", "titulo", "resumo"],
        "properties": {
          "paragrafo": { "type": "string", "pattern": "^P[0-9]+$" },
          "titulo": { "type": "string", "minLength": 1, "maxLength": 80 },
          "resumo": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    },
    "momentos": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["paragrafo", "citacao", "tipo", "titulo", "curto", "explicacao"],
        "properties": {
          "paragrafo": { "type": "string", "pattern": "^P[0-9]+$" },
          "citacao": { "type": "string", "minLength": 1, "maxLength": 200 },
          "tipo": { "type": "string", "enum": ["conceito", "dado", "contexto", "pergunta"] },
          "titulo": { "type": "string", "minLength": 1, "maxLength": 80 },
          "curto": { "type": "string", "minLength": 1, "maxLength": 20 },
          "explicacao": { "type": "string", "minLength": 1, "maxLength": 600 }
        }
      }
    }
  }
}
