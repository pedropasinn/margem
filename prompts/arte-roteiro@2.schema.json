{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://margem.local/prompts/arte-roteiro@2.schema.json",
  "title": "Roteiro da análise curta, algoritmo v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tese",
    "afirmacoes_da_tese",
    "gancho",
    "batidas"
  ],
  "properties": {
    "tese": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "afirmacoes_da_tese": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "gancho": {
      "type": "string",
      "enum": [
        "detalhe",
        "contraste",
        "pergunta",
        "cena",
        "paradoxo"
      ]
    },
    "batidas": {
      "type": "array",
      "minItems": 3,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "papel",
          "narracao",
          "afirmacoes",
          "regiao",
          "enquadramento",
          "novidade"
        ],
        "properties": {
          "papel": {
            "type": "string",
            "enum": [
              "abertura",
              "evidencia_visual",
              "contexto",
              "interpretacao",
              "fechamento"
            ]
          },
          "narracao": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "afirmacoes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "regiao": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "enquadramento": {
            "type": "string",
            "enum": [
              "inteiro",
              "meio",
              "detalhe"
            ]
          },
          "novidade": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    }
  }
}