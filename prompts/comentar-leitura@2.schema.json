{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://margem.local/prompts/comentar-leitura@2.schema.json",
  "title": "Saída da leitura comentada: uma fala por pausa",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "falas"
  ],
  "properties": {
    "falas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pausa",
          "fala"
        ],
        "properties": {
          "pausa": {
            "type": "string",
            "pattern": "^P[0-9]{3,4}$"
          },
          "fala": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        }
      }
    }
  }
}
