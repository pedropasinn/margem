{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://margem.local/prompts/explicar-resolucao@2.schema.json",
  "title": "Explicação de um ponto da resolução, versão 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "texto",
    "passos"
  ],
  "properties": {
    "texto": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000,
      "pattern": "\\S"
    },
    "passos": {
      "type": "array",
      "minItems": 0,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "texto",
          "calculo"
        ],
        "properties": {
          "texto": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "\\S"
          },
          "calculo": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  }
}