{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://margem.local/prompts/esquema-capitulo@2.schema.json",
  "title": "Esquema do capítulo resumido em fluxograma vertical, versão 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["titulo", "grupos", "nos", "ligacoes"],
  "properties": {
    "titulo": { "type": "string", "minLength": 1, "maxLength": 200 },
    "grupos": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "titulo", "resumo"],
        "properties": {
          "id": { "type": "string", "pattern": "^G[0-9]{1,2}$" },
          "titulo": { "type": "string", "minLength": 1, "maxLength": 80 },
          "resumo": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    },
    "nos": {
      "type": "array",
      "minItems": 2,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "rotulo", "tipo", "grupo", "detalhe", "elemento", "citacao"],
        "properties": {
          "id": { "type": "string", "pattern": "^N[0-9]{1,2}$" },
          "rotulo": { "type": "string", "minLength": 1, "maxLength": 80 },
          "tipo": { "type": "string", "enum": ["conceito", "tese", "mecanismo", "exemplo", "questao", "contraste", "conclusao"] },
          "grupo": { "type": "string", "pattern": "^G[0-9]{1,2}$" },
          "detalhe": { "type": "string", "minLength": 1, "maxLength": 400 },
          "elemento": { "anyOf": [{ "type": "string", "pattern": "^E[0-9]{1,3}$" }, { "type": "null" }] },
          "citacao": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["bloco_id", "texto"],
                "properties": {
                  "bloco_id": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" },
                  "texto": { "type": "string", "minLength": 1, "maxLength": 1000 }
                }
              },
              { "type": "null" }
            ]
          }
        }
      }
    },
    "ligacoes": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["de", "para", "rotulo", "forca"],
        "properties": {
          "de": { "type": "string", "pattern": "^N[0-9]{1,2}$" },
          "para": { "type": "string", "pattern": "^N[0-9]{1,2}$" },
          "rotulo": { "type": "string", "minLength": 1, "maxLength": 40 },
          "forca": { "type": "string", "enum": ["forte", "fraca"] }
        }
      }
    }
  }
}
