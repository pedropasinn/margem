{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@margem/core": ["../core/src/index.ts"],
      "@margem/core/audio": ["../core/src/audio.ts"],
      "@margem/core/midia": ["../core/src/midia.ts"],
      "@margem/core/segmentos": ["../core/src/segmentos.ts"],
      "@margem/core/eink": ["../core/src/eink.ts"],
      "@margem/core/fluxograma": ["../core/src/fluxograma.ts"],
      "@margem/core/visita": ["../core/src/visita.ts"],
      "@margem/core/leitura-comentada": ["../core/src/leitura-comentada.ts"],
      "@margem/core/karaoke": ["../core/src/karaoke.ts"],
      "@margem/core/youtube": ["../core/src/youtube.ts"],
      "@margem/contratos": ["../contratos/src/index.ts"],
      "@margem/contratos/texto": ["../contratos/src/texto.ts"],
      "@margem/contratos/regras": ["../contratos/src/regras.ts"],
      "@margem/contratos/sala": ["../contratos/src/sala.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "../core/src/**/*.ts", "../contratos/src/**/*.ts"],
  "exclude": ["node_modules", "dist", "../core/src/**/*.test.ts", "../contratos/src/**/*.test.ts"]
}
