# Ponto único do nome do produto na distribuição. Trocar o nome é editar este arquivo e os padrões
# no topo de instalar.sh e instalar.ps1 (que valem quando o script é baixado sozinho, sem este
# arquivo ao lado); tools/tests/distribuicao.test.mjs confere que os três batem.
# Formato: CHAVE=valor, sem aspas e sem espaços em volta do "=".

# Nome mostrado nas mensagens dos scripts.
PRODUTO_NOME=Margem
# Projeto no Docker Compose (prefixo dos containers e volumes), pasta da instalação (~/<projeto>)
# e nome do comando de atalho (`<projeto> iniciar`). Trocar depois de instalado cria volumes novos.
PRODUTO_PROJETO=margem
# Imagem. Enquanto não houver imagem publicada, os scripts a constroem a partir do código-fonte.
PRODUTO_IMAGEM=ghcr.io/pedropasinn/margem:latest
# Repositório público do código (na conta pessoal pedropasinn). Vai para o rótulo
# org.opencontainers.image.source da imagem.
PRODUTO_REPOSITORIO=https://github.com/pedropasinn/margem
# De onde o script baixado sozinho busca o compose.yml (assets do release).
PRODUTO_RELEASE=https://github.com/pedropasinn/margem/releases/latest/download
